# Root reference only — the app actually reads backend/.env and frontend/.env.
# Copy each into place:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env   (if present)
#
# This file just lists every variable used across the stack in one place.

# ===== backend/.env =====
APP_NAME=Dayflow HRMS
APP_ENV=development
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dayflow

SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_TOKEN_EXPIRE_HOURS=48
JWT_ALGORITHM=HS256

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_OUTBOX_DIR=var/mail
MAIL_FROM=no-reply@dayflow.co
AUTO_VERIFY_EMAIL=false

WORKDAY_START=09:00
WORKDAY_MINUTES=480
HALF_DAY_MINUTES=240
ANNUAL_PAID_LEAVE_DAYS=18
ANNUAL_SICK_LEAVE_DAYS=10

# ===== frontend/.env =====
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Leave unset to auto-derive from window.location; set only if your WS host differs
# VITE_WS_URL=ws://localhost:8000/api/v1/ws
